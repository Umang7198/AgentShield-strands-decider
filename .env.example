# Copy to .env and fill in. Never commit .env.

# --- Host agent LLM (OpenAI-compatible custom endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Exact model id as listed by your gateway
MODEL_ID=

# --- Strands Decider server ---
DECIDER_URL=http://127.0.0.1:8099

# --- Approvals (optional shared secret for the review API) ---
APPROVAL_TOKEN=

# --- Observability (used from the observability milestone) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentshield
