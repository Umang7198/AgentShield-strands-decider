# Copy to .env and fill in. Never commit .env.

# --- Host agent LLM (OpenAI-compatible custom endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Exact model id as listed by your gateway
MODEL_ID=

# --- Strands Decider server ---
DECIDER_URL=http://127.0.0.1:8099

# --- Docker (optional) ---
# New machine: cp .env.example .env && docker compose up --build
# FAKE_DECIDER=1 is the image default (policy still runs). To use a Decider on the host:
# FAKE_DECIDER=0
# DECIDER_URL=http://host.docker.internal:8099

# --- Database (optional) ---
# Default for python app.py is sqlite:///./agentshield.db (no Docker).
# Docker SQLite lives at sqlite:////data/agentshield.db (compose volume).
# Optional Postgres: docker compose --profile postgres up -d postgres
# DATABASE_URL=postgresql+psycopg://agentshield:agentshield@127.0.0.1:5432/agentshield

# --- Approvals (optional shared secret for the review API) ---
APPROVAL_TOKEN=

# --- Handbook RAG ---
# python app.py uses MiniLM + Chroma when installed (`make install-rag`).
# Tests force the hash embedder (AGENTSHIELD_RAG_HASH=1 in tests/conftest.py).
# AGENTSHIELD_RAG_HASH=1          # force hash/memory even if .[rag] is installed
# AGENTSHIELD_RAG_MINILM=0        # disable MiniLM
# AGENTSHIELD_RAG_CHROMA=0        # disable Chroma (in-memory cosine instead)

# --- Observability (used from the observability milestone) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentshield
